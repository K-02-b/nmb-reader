# docker compose 用的环境变量（复制成 .env；.env 已在 .gitignore 里）
# cp .env.example .env

# --- 必须改 -----------------------------------------------------------------
# PostgreSQL 口令
POSTGRES_PASSWORD=change-me-please
# 首次启动创建的管理员 admin 的口令
THREAD_READER_ADMIN_PASSWORD=change-me-too

# --- 登录 Cookie（不填就下不了串，其余功能正常） ----------------------------
# 推荐留空，让每个用户在前端「设置 → Cookie」导入自己的；这里只是自用实例的兜底
THREAD_READER_NMB_COOKIE=

# --- 用户 Cookie 的加密密钥（可选） -----------------------------------------
# 留空会自动生成 data/secret.key（首次启动时，权限 600）。
# 想多实例共享同一份 Cookie 数据、或从备份恢复后仍能解密，就显式设一个固定值：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
THREAD_READER_SECRET_KEY=

# --- 构建期镜像源（默认已是国内源，想切回官方源就改这里） -------------------
# 清华的 npm 镜像已下线，npmmirror 是国内对应源
NPM_REGISTRY=https://registry.npmmirror.com/
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 官方源：
# NPM_REGISTRY=https://registry.npmjs.org/
# PIP_INDEX_URL=https://pypi.org/simple

# Docker Hub 不可达时（国内较常见）指向加速器，基础镜像也走它
# NODE_IMAGE=docker.m.daocloud.io/library/node:20-bookworm-slim
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim

# --- 可选 -------------------------------------------------------------------
# 对外端口
XDNMB_PORT=8080
# 走 HTTPS（nginx/caddy 反代）时设为 true，否则登录会掉
THREAD_READER_COOKIE_SECURE=false
# 抓取节奏：每个请求通道之间的间隔（秒）
THREAD_READER_FETCH_PAUSE=1.2
# 单串页数安全上限（防止误输入串号抓一个巨型串）
THREAD_READER_FETCH_MAX_PAGES=2000
# 用户可在「设置 → 下载」里为自己的任务调整，服务器侧夹在这个硬上限内
THREAD_READER_FETCH_MAX_PAGES_CEILING=20000
# 页请求并发度：对站点的速率 ≈ 并发 / FETCH_PAUSE
THREAD_READER_FETCH_CONCURRENCY=4
THREAD_READER_FETCH_CONCURRENCY_CEILING=8
# 图片并发（图床是静态 CDN，放宽风险很小）
THREAD_READER_IMAGE_CONCURRENCY=4
# 是否把图片抓到本地（false 则只存链接、访问时回源图床）
THREAD_READER_IMAGES_ENABLED=true
