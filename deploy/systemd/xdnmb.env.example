# 匿名版阅读器后端环境变量（复制成 /opt/xdnmb-reader/.env，或写进 systemd 的 EnvironmentFile）
THREAD_READER_HOST=127.0.0.1
THREAD_READER_PORT=8080
THREAD_READER_SESSION_TTL=43200
# HTTPS 下必须为 true，否则登录会掉；纯 HTTP 下必须为 false
THREAD_READER_COOKIE_SECURE=true

# 数据与数据库（默认 SQLite 单文件；生产可换成 PostgreSQL / MySQL，见 DEPLOY_SERVER.md）
THREAD_READER_DATA_DIR=/opt/xdnmb-reader/backend/data
# THREAD_READER_DB_URL=postgresql+psycopg://xdnmb:xdnmb@127.0.0.1:5432/xdnmb

# 首次启动创建 admin 的口令
THREAD_READER_ADMIN_PASSWORD=change-me

# 用户 Cookie 的加密主密钥；留空则自动生成 data/secret.key（权限 600）
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
THREAD_READER_SECRET_KEY=

# 服务器级兜底 Cookie（可选；推荐让用户在前端各自导入）
THREAD_READER_NMB_COOKIE=
THREAD_READER_FETCH_PAUSE=1.2
# 单串页数安全上限，以及用户可自行调整的硬上限
THREAD_READER_FETCH_MAX_PAGES=2000
THREAD_READER_FETCH_MAX_PAGES_CEILING=20000
# 并发度（对站点速率 ≈ 并发 / FETCH_PAUSE）
THREAD_READER_FETCH_CONCURRENCY=4
THREAD_READER_FETCH_CONCURRENCY_CEILING=8
THREAD_READER_IMAGE_CONCURRENCY=4

# 下载 worker：生产用独立进程（xdnmb-worker.service），所以这里必须为 false
THREAD_READER_WORKER_ENABLED=false
THREAD_READER_WORKER_POLL_SECONDS=1.0

# 检索后端：fts5（默认，随 SQLite）或 manticore
THREAD_READER_SEARCH_BACKEND=fts5
THREAD_READER_MANTICORE_URL=http://127.0.0.1:9308

# 图片本地化
THREAD_READER_IMAGES_ENABLED=true
